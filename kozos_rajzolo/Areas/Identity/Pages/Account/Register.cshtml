@page
@model KozosRajzolo.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Regisztráció";
}
<!DOCTYPE html>
<html lang="hu"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Regisztráció · Közös Rajzoló</title><link rel="stylesheet" href="/css/site.css" /></head>
<body class="account-body"><main class="account-card">
    <a class="account-brand" href="/">✎ Közös Rajzoló</a><h1>Fiók létrehozása</h1><p class="account-subtitle">Regisztrálj, hogy saját rajzszobákat hozhass létre.</p>
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <form method="post">
        <label asp-for="Input.DisplayName">Megjelenített név</label><input asp-for="Input.DisplayName" autocomplete="name" placeholder="Pl. Teszt Elek"/><span asp-validation-for="Input.DisplayName" class="validation"></span>
        <label asp-for="Input.Email">E-mail-cím</label><input asp-for="Input.Email" autocomplete="email"/><span asp-validation-for="Input.Email" class="validation"></span>
        <label asp-for="Input.Password">Jelszó</label><input asp-for="Input.Password" autocomplete="new-password"/><span asp-validation-for="Input.Password" class="validation"></span>
        <label asp-for="Input.ConfirmPassword">Jelszó megerősítése</label><input asp-for="Input.ConfirmPassword" autocomplete="new-password"/><span asp-validation-for="Input.ConfirmPassword" class="validation"></span>
        <button class="primary account-submit" type="submit">Regisztráció</button>
    </form>
    <p class="account-switch">Van már fiókod? <a href="/Identity/Account/Login">Bejelentkezés</a></p>
</main></body></html>
